# MẪU biến môi trường production. Copy thành .env (KHÔNG commit) rồi điền.
# Sinh khóa ngẫu nhiên:  pwsh scripts/new-secrets.ps1   (hoặc: bash scripts/new-secrets.sh)
# Quy ước ASP.NET: dấu "__" thay cho ":" trong appsettings (Jwt__SigningKey = Jwt:SigningKey).

# --- Bắt buộc: thiếu là app dừng khi khởi động ---
Jwt__SigningKey=
PersonalData__HashKey=
# Chuỗi kết nối do docker-compose.prod.yml tự ghép từ RR_APP_PASSWORD (role renting_room_app) — không cần khai ở đây.
DataProtection__KeysPath=/keys
AllowedHosts=tro.example.vn;localhost

# --- Tài khoản admin đầu tiên (bị bắt đổi mật khẩu ở lần đăng nhập đầu, rồi xóa 2 dòng Password) ---
Bootstrap__Admin__Phone=
Bootstrap__Admin__Email=
Bootstrap__Admin__Password=

# --- Tùy chọn: bật kênh thông báo (để trống = kênh đó "chưa cấu hình", app vẫn chạy) ---
ZaloBot__Token=
ZaloBot__BotName=
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=

# --- Postgres container (docker-compose.prod.yml) ---
POSTGRES_DB=renting_room
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Hai role DB tạo ở lần đầu khởi tạo volume: owner chỉ để migrate, app là role API dùng (quyền tối thiểu). Mật khẩu ngẫu nhiên, khác nhau.
RR_OWNER_PASSWORD=
RR_APP_PASSWORD=

# --- Kho ảnh / tài liệu (M09) ---
# docker-compose.prod.yml mặc định dùng MinIO (S3) và tự đặt ServiceUrl / Bucket / khóa app từ các biến MINIO_* bên dưới.
# Muốn lưu trên ổ đĩa thay vì MinIO: Storage__Provider=Local (file nằm trong volume `files` — phải backup).
# Storage__Provider=S3
# Hạn mức dung lượng mỗi tổ chức (byte), mặc định 5 GB:
# Storage__OrganizationQuotaBytes=5368709120
# MinIO: tài khoản quản trị (chỉ dùng để dựng bucket) và tài khoản RIÊNG của app (chỉ có quyền trên bucket). Mật khẩu mạnh, không dùng mặc định.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
# Image MinIO không còn đăng công khai — xem docs/guides/file-storage.md mục 6 (đặt MINIO_IMAGE / MINIO_MC_IMAGE nếu dùng registry riêng)
# MINIO_IMAGE=
# MINIO_MC_IMAGE=
# Cổng API trên host (chỉ 127.0.0.1)
# API_PORT=8080
