{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "renting_room",
    "Audience": "renting_room_api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SessionAbsoluteDays": 90,
    "SessionCacheSeconds": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "Login": { "PermitLimit": 20, "WindowSeconds": 60 },
    "LoginPerAccount": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Sensitive": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Import": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Authenticated": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Anonymous": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Write": { "PermitLimit": 60, "WindowSeconds": 60 },
    "MaxConcurrentRequestsPerClient": 20,
    "ConcurrentQueueLimit": 50
  },
  "Idempotency": {
    "RetentionHours": 24,
    "InProgressTimeoutSeconds": 120,
    "MaxStoredResponseBytes": 262144
  },
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Bootstrap": {
    "Admin": {
      "FullName": "System Administrator",
      "Phone": "",
      "Email": "",
      "Password": ""
    }
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "Username": "",
      "FromAddress": "",
      "FromName": "Renting Room"
    }
  },
  "ZaloBot": {
    "Token": "",
    "ApiBaseUrl": "https://bot-api.zaloplatforms.com",
    "BotName": "",
    "PollerEnabled": true,
    "PollTimeoutSeconds": 25
  },
  "Notifications": {
    "DispatcherEnabled": true,
    "DispatchIntervalSeconds": 2,
    "BatchSize": 20,
    "LeaseMinutes": 5,
    "SendWindowStartHour": 8,
    "SendWindowEndHour": 20,
    "ZaloPerSecond": 5,
    "EmailPerSecond": 1,
    "ReminderSchedulerEnabled": true,
    "ReminderIntervalMinutes": 60,
    "RetentionDays": 180
  },
  "Storage": {
    "Provider": "Local",
    "OrganizationQuotaBytes": 5368709120,
    "Local": { "RootPath": "App_Data/files" },
    "S3": {
      "ServiceUrl": "",
      "Bucket": "renting-room",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true,
      "Region": "us-east-1",
      "SignedUrlSeconds": 300,
      "TimeoutSeconds": 30
    }
  },
  "Seed": {
    "DemoData": {
      "Enabled": false
    }
  }
}
