@host = http://localhost:5213
@api = {{host}}/api/v1

# Chạy lần lượt từ trên xuống. {{$guid}} sinh Idempotency-Key mới mỗi lần gửi. Mật khẩu admin = giá trị Bootstrap:Admin:Password trong user-secrets.

### 1. Admin đăng nhập
# @name adminLogin
POST {{api}}/auth/login
Content-Type: application/json

{
  "username": "0900000001",
  "password": "<mật khẩu admin trong user-secrets>"
}

### 2. Thông tin tài khoản đang đăng nhập
GET {{api}}/me
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### 3. Admin tạo tổ chức + tài khoản chủ trọ (trả mật khẩu tạm một lần)
# @name createOrg
POST {{api}}/admin/organizations
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "code": "NT-DEMO",
  "name": "Nhà trọ Demo",
  "contactPhone": "0987654321",
  "owner": { "fullName": "Trần Văn Chủ", "phone": "0987654321", "email": "chu.tro@example.com" }
}

### 4. Danh sách tổ chức (phân trang, tìm kiếm)
GET {{api}}/admin/organizations?search=demo&status=Active&page=1&pageSize=20
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### 5. Chủ trọ đăng nhập bằng mật khẩu tạm → mustChangePassword = true
# @name ownerLogin
POST {{api}}/auth/login
Content-Type: application/json

{
  "username": "0987654321",
  "password": "{{createOrg.response.body.temporaryPassword}}"
}

### 6. Gọi API nghiệp vụ khi chưa đổi mật khẩu → 403 PASSWORD_CHANGE_REQUIRED
GET {{api}}/rooms
Authorization: Bearer {{ownerLogin.response.body.accessToken}}

### 7. Đổi mật khẩu → nhận cặp token mới
# @name changePassword
POST {{api}}/auth/change-password
Authorization: Bearer {{ownerLogin.response.body.accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{createOrg.response.body.temporaryPassword}}",
  "newPassword": "ChuTro2026x"
}

### 8a. Tạo khu trọ
# @name createProperty
POST {{api}}/properties
Authorization: Bearer {{changePassword.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "code": "KCG",
  "name": "Khu Cầu Giấy",
  "address": { "streetAddress": "Số 5 ngõ 10 Trần Duy Hưng", "communeName": "Phường Cầu Giấy", "provinceName": "Hà Nội" },
  "billingDefaults": { "anchorDay": 5, "chargeMode": "Prepaid", "paymentDueDays": 5, "prorationMode": "Daily", "noticeDays": 30 }
}

### 8b. Khai báo bên cho thuê (bắt buộc trước khi kích hoạt hợp đồng)
PUT {{api}}/properties/{{createProperty.response.body.id}}/lessor
Authorization: Bearer {{changePassword.response.body.accessToken}}
Content-Type: application/json

{
  "type": "Individual", "name": "Nguyễn Văn Chủ", "address": "Số 1 Láng Hạ, Hà Nội", "phone": "0911222333",
  "idType": "CitizenId", "idNumber": "001080012345", "dateOfBirth": "1980-01-01"
}

### 8c. Tạo phòng hàng loạt
POST {{api}}/properties/{{createProperty.response.body.id}}/rooms/bulk
Authorization: Bearer {{changePassword.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "floors": [ { "floor": "1", "codes": ["101", "102", "103"] } ],
  "maxOccupants": 2, "listedRent": 3500000, "areaM2": 18.5
}

### 9. Danh sách phòng (trạng thái tính từ hợp đồng)
# @name rooms
GET {{api}}/rooms?propertyId={{createProperty.response.body.id}}
Authorization: Bearer {{changePassword.response.body.accessToken}}

### 9a. Tạo người thuê
# @name createRenter
POST {{api}}/renters
Authorization: Bearer {{changePassword.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "fullName": "Trần Thị Lan", "dateOfBirth": "2002-04-15", "gender": "Female", "phone": "0987654321",
  "idType": "CitizenId", "idNumber": "001302012345", "permanentAddress": "Nam Định"
}

### 9b. Tạo hợp đồng nháp (giá, cọc, kỳ thu lấy mặc định từ phòng/khu nếu bỏ trống)
# @name createContract
POST {{api}}/contracts
Authorization: Bearer {{changePassword.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "roomId": "{{rooms.response.body.items[0].id}}",
  "contract": {
    "representativeRenterId": "{{createRenter.response.body.id}}",
    "startDate": "2026-10-05",
    "endDate": "2027-10-04",
    "occupants": [ { "renterId": "{{createRenter.response.body.id}}" } ]
  }
}

### 9c. Kích hoạt hợp đồng (bàn giao phòng)
POST {{api}}/contracts/{{createContract.response.body.id}}/activate
Authorization: Bearer {{changePassword.response.body.accessToken}}

### 9d. Chi tiết hợp đồng
GET {{api}}/contracts/{{createContract.response.body.id}}
Authorization: Bearer {{changePassword.response.body.accessToken}}

### 10. Làm mới token (refresh token cũ bị thu hồi)
# @name refresh
POST {{api}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{changePassword.response.body.refreshToken}}"
}

### 11. Đăng xuất phiên hiện tại
POST {{api}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh.response.body.refreshToken}}"
}

### 12. Dữ liệu sai → 400 VALIDATION_FAILED
POST {{api}}/auth/login
Content-Type: application/json

{
  "username": "",
  "password": ""
}

### 13. Không có token → 401 AUTHENTICATION_REQUIRED
GET {{api}}/rooms

### 14. Health check (không cần đăng nhập)
GET {{host}}/health/ready

### 15. Gửi lại CÙNG Idempotency-Key → trả lại kết quả cũ (header Idempotent-Replayed: true), không tạo khu thứ 2
# Bấm request này 2 lần liên tiếp.
POST {{api}}/properties
Authorization: Bearer {{changePassword.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: demo-fixed-key-0001

{
  "code": "KDEMO2",
  "name": "Khu demo idempotency",
  "address": { "streetAddress": "Số 9", "communeName": "Phường Láng", "provinceName": "Hà Nội" }
}
