# MẪU biến môi trường UAT (docker-compose.uat.yml). Copy thành .env.uat (KHÔNG commit) rồi điền.
# Sinh khóa ngẫu nhiên: pwsh scripts/new-secrets.ps1 (hoặc bash scripts/new-secrets.sh) rồi dán vào các dòng dưới.

POSTGRES_PASSWORD=
RR_OWNER_PASSWORD=
RR_APP_PASSWORD=
Jwt__SigningKey=
PersonalData__HashKey=

# SystemAdmin (bị bắt đổi mật khẩu ở lần đăng nhập đầu), tối thiểu 12 ký tự
Bootstrap__Admin__Password=

# Mật khẩu 2 loại tài khoản demo (chủ trọ / quản lý) — cho tester biết, KHÔNG dùng lại mật khẩu thật
Seed__DemoData__OwnerPassword=
Seed__DemoData__ManagerPassword=

# Host / origin của giao diện UAT và cổng API trên máy chủ (chỉ 127.0.0.1)
AllowedHosts=localhost
UAT_WEB_ORIGIN=http://localhost:5173
# UAT_API_PORT=8090
