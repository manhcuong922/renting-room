{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "renting_room",
    "Audience": "renting_room_api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SessionAbsoluteDays": 90,
    "SessionCacheSeconds": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "Login": { "PermitLimit": 20, "WindowSeconds": 60 },
    "LoginPerAccount": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Sensitive": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Authenticated": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Anonymous": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Write": { "PermitLimit": 60, "WindowSeconds": 60 },
    "MaxConcurrentRequestsPerClient": 10
  },
  "Idempotency": {
    "RetentionHours": 24,
    "InProgressTimeoutSeconds": 120,
    "MaxStoredResponseBytes": 262144
  },
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Bootstrap": {
    "Admin": {
      "FullName": "System Administrator",
      "Phone": "",
      "Email": "",
      "Password": ""
    }
  }
}
